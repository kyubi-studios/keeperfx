+// --- alignment trap reporting (KeeperFX PSP port diagnostics) ---
+#include <cstdio>
+#include <set>
+static void ReportUnaligned(const char *what, u32 addr, u32 pc) {
+	static std::set<u32> seen;
+	if (seen.size() > 4000 || !seen.insert(pc).second)
+		return;
+	fprintf(stderr, "UNALIGNED %s addr=%08x pc=%08x\n", what, addr, pc);
+	fflush(stderr);
+}
+#define CHECK_ALIGN(what, mask) do { if (addr & (mask)) ReportUnaligned(what, addr, PC); } while (0)
